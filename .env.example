# Copy to .env and fill in. .env is gitignored; this file is committed.
#
# PROJECT_DATA_DIR is normally set by direnv from .envrc and does not need to be
# repeated here. It is listed so the requirement is documented for anyone running
# this without direnv — a container, CI, or a server.
# It must point OUTSIDE this repo.
PROJECT_DATA_DIR=/absolute/path/to/data/research-corpus

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=corpus_migrate
POSTGRES_PASSWORD=
POSTGRES_DB=corpus
POSTGRES_PORT=5432
CORPUS_APP_PASSWORD=
CORPUS_INGEST_PASSWORD=

# Connection string used by the application and Alembic.
DATABASE_URL=postgresql+psycopg://corpus_migrate:CHANGEME@localhost:5432/corpus
# RLS-bound role. Isolation tests must use this, never the superuser.
APP_DATABASE_URL=postgresql+psycopg://corpus_app:CHANGEME@localhost:5432/corpus

# --- Postgres tuning --------------------------------------------------------
# Raise these once Docker Desktop's VM memory is increased from the 8GB default.
# maintenance_work_mem is the one that decides whether an HNSW build takes hours
# or days: pgvector builds the graph in memory and falls off a cliff when it spills.
PG_SHARED_BUFFERS=1GB
PG_WORK_MEM=64MB
PG_MAINTENANCE_WORK_MEM=2GB
PG_PARALLEL_MAINTENANCE=4
PG_PARALLEL_GATHER=4
PG_EFFECTIVE_CACHE_SIZE=4GB

# --- Tenancy ----------------------------------------------------------------
# Resolved from config, never from an MCP tool argument or model output.
CORPUS_TENANT_SLUG=default

# --- Supadata ---------------------------------------------------------------
SUPADATA_API_KEY=
SUPADATA_BASE_URL=https://api.supadata.ai/v1
SUPADATA_MONTHLY_CREDITS=30000
# Rate limit is plan-dependent and undocumented. Set conservatively; raise once
# a real 429 boundary is observed.
SUPADATA_RPS=2.0

# --- Entity extraction (Claude Code, headless) -------------------------------
# Not read by pydantic-settings — the `claude` CLI reads this straight from the
# process environment, which is why scripts/nightly.sh explicitly exports .env
# rather than relying on Python's own .env parsing. Generate with:
#   claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
# "haiku" is the Claude Code CLI's model alias, not an Anthropic API model ID.
ENTITY_EXTRACTION_MODEL=haiku
# 120s is fine for --concurrency 1. Above ~15x concurrent `claude -p` calls, measured
# individual latency rises to ~250s (docs/DECISIONS.md) — raise this or timeouts start
# eating otherwise-fine documents, not just genuinely stuck ones.
ENTITY_EXTRACTION_TIMEOUT_S=240.0
