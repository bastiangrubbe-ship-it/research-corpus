# Copy to .env and fill in. .env is gitignored; this file is committed.
#
# PROJECT_DATA_DIR is normally set by direnv from .envrc and does not need to be
# repeated here. It is listed so the requirement is documented for anyone running
# this without direnv — a container, CI, or a server.
#
# It must point OUTSIDE this repo. Never ./data, never a path inside the checkout.
PROJECT_DATA_DIR=/absolute/path/to/data/research-corpus

# --- Add real settings below, with placeholder values only ---
# API_KEY=
# POSTGRES_USER=research-corpus
# POSTGRES_PASSWORD=
# POSTGRES_DB=research-corpus
