# Loaded by direnv on `cd` into this repo. Committed on purpose — it contains no
# secrets, only the location of this project's data.
#
# Run `direnv allow` once after cloning.
#
# On a Linux server, set PROJECT_DATA_DIR in the systemd unit or shell profile
# instead (e.g. /srv/data/research-corpus). No code changes are needed.

export PROJECT_DATA_DIR="$HOME/data/research-corpus"

# Secrets and per-machine values go in .env, which is gitignored.
dotenv_if_exists .env
